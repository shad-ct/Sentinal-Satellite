# ============================================================
# Sentinel-2 Change Detection System — Environment Variables
# ============================================================
# Copy this file to .env and fill in your credentials.
# NEVER commit .env to version control.

# ── Copernicus Data Space Ecosystem ──────────────────────────
# Register free at: https://dataspace.copernicus.eu/
# Then create S2PP (OAuth2) credentials in your dashboard.
COPERNICUS_CLIENT_ID=
COPERNICUS_CLIENT_SECRET=

# Optional: your Copernicus username/email (used for OData basic auth fallback)
COPERNICUS_USERNAME=
COPERNICUS_PASSWORD=

# ── Sentinel Hub (optional, alternative image source) ────────
# Only needed if you prefer SH Process API over CDSE direct download
SENTINELHUB_CLIENT_ID=
SENTINELHUB_CLIENT_SECRET=

# ── Application Settings ──────────────────────────────────────
APP_ENV=development
LOG_LEVEL=INFO
SECRET_KEY=change-me-to-a-random-secret-key

# ── Data Directories ─────────────────────────────────────────
DATA_DIR=./data
MODELS_DIR=./models

# ── API URLs ──────────────────────────────────────────────────
CDSE_TOKEN_URL=https://identity.dataspace.copernicus.eu/auth/realms/CDSE/protocol/openid-connect/token
CDSE_CATALOG_URL=https://catalogue.dataspace.copernicus.eu
CDSE_S3_ENDPOINT=https://eodata.dataspace.copernicus.eu
SENTINELHUB_BASE_URL=https://services.sentinel-hub.com

# ── Default Search Parameters ─────────────────────────────────
DEFAULT_MAX_CLOUD_COVERAGE=20
DEFAULT_SEARCH_WINDOW_DAYS=15
DEFAULT_RESOLUTION=10

# ── Backend Server ────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
